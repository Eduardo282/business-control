# ============================================
# Docker Environment — Business Control
# ============================================
# Copy this file to .env and fill in your values.
# docker compose automatically reads .env from the same directory.

# ─── Database ────────────────────────────────────
MYSQL_ROOT_PASSWORD=your-secure-db-password
MYSQL_DATABASE=business_control
DB_EXTERNAL_PORT=3307

# ─── Backend ─────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
MASTER_PASSWORD=your-master-password

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ZeroBounce
ZEROBOUNCE_API_KEY=your-api-key

# CORS — should match the URL where the frontend is served
CORS_ORIGIN=http://localhost

# ─── Frontend ────────────────────────────────────
# The URL where the browser will reach the backend API
VITE_API_URL=http://localhost:4000/graphql

# ─── Ports ───────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=80
